<h2>Generate Card Proxies</h2>

<h3>Option 1: From ArkhamDB Deck</h3>
<p>
<%= form_tag('/deck', method: "get", class: "pdf-form") do %>
  <%= label_tag(:id, "Deck ID or link from ") %>
  <%= link_to "ArkhamDB", "https://arkhamdb.com", target: "_blank" %>
  <br>
  <%= text_field_tag(:id, nil, placeholder: "e.g., 12345") %>
  <%= submit_tag("Get PDF from Deck", data: { disable_with: false }) %>
<% end %>
</p>

<h3>Option 2: From Card IDs</h3>
<p>
<%= form_tag('/card', method: "get", class: "pdf-form") do %>
  <%= label_tag(:card_ids, "Card IDs (comma-separated)") %>
  <br>
  <%= text_field_tag(:card_ids, nil, placeholder: "e.g., 01001, 01002, 01003", size: 50) %>
  <%= submit_tag("Get PDF from Cards", data: { disable_with: false }) %>
<% end %>
</p>

<h3>Option 3: From Pack Code</h3>
<p>
<%= form_tag('/pack', method: "get", class: "pdf-form") do %>
  <%= label_tag(:pack_code, "Pack Code(s) - comma-separated for multiple") %>
  <br>
  <%= text_field_tag(:pack_code, nil, placeholder: "e.g., core, dwl, ptc", size: 50) %>
  <%= submit_tag("Get PDF from Pack(s)", data: { disable_with: false }) %>
<% end %>
</p>

<h2 style="margin-top: 40px;">Netrunner Card Proxies</h2>

<h3>Option 1: From Card List</h3>
<p>
<form action="/netrunner" method="post" class="pdf-form">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= label_tag(:card_list, "Card List (one per line in format: 2x Card Title)") %>
  <br>
  <%= text_area_tag(:card_list, nil, placeholder: "2x Hedge Fund\n3x Sure Gamble\n1x Archer", rows: 10, cols: 50) %>
  <br>
  <%= submit_tag("Get Netrunner PDF", data: { disable_with: false }) %>
</form>
</p>

<h3>Option 2: From Pack Code</h3>
<p>
<form action="/netrunner/pack" method="post" class="pdf-form">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= label_tag(:pack_code, "Pack Code") %>
  <br>
  <%= text_field_tag(:pack_code, nil, placeholder: "e.g., core, td, ce", size: 50) %>
  <br>
  <%= submit_tag("Get Netrunner Pack PDF", data: { disable_with: false }) %>
</form>
</p>

<script>
  // Re-enable submit buttons after download starts
  document.querySelectorAll('.pdf-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      const submitBtn = this.querySelector('input[type="submit"]');
      // Re-enable button after 2 seconds
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.value = submitBtn.defaultValue;
      }, 2000);
    });
  });
</script>

<% if flash[:alert] %>
    <div class="alert" style="color: red; margin-top: 20px;"> <%= flash[:alert] %> </div>
<% end %>
