<h2>Generate Card Proxies</h2>

<h3>Option 1: From ArkhamDB Deck</h3>
<p>
<%= form_tag('/deck', method: "get", class: "pdf-form") do %>
  <%= label_tag(:id, "Deck ID or link from ") %>
  <%= link_to "ArkhamDB", "https://arkhamdb.com", target: "_blank" %>
  <br>
  <%= text_field_tag(:id, nil, placeholder: "e.g., 12345") %>
  <br><br>
  <span>Only include factions (optional; leave all unchecked for all):</span><br>
  <% %w[guardian seeker rogue mystic survivor neutral mythos].each do |fc| %>
    <%= check_box_tag("faction_code[]", fc, false, id: "deck_faction_#{fc}") %>
    <%= label_tag("deck_faction_#{fc}", fc.titleize) %>
  <% end %>
  <br>
  <span>Only include types (optional; leave all unchecked for all):</span><br>
  <% %w[asset event skill treachery enemy location act agenda story investigator].each do |tc| %>
    <%= check_box_tag("type_code[]", tc, false, id: "deck_type_#{tc}") %>
    <%= label_tag("deck_type_#{tc}", tc.titleize) %>
  <% end %>
  <br><br>
  <%= submit_tag("Get PDF from Deck", data: { disable_with: false }) %>
<% end %>
</p>

<h3>Option 2: From Card IDs</h3>
<p>
<%= form_tag('/card', method: "get", class: "pdf-form") do %>
  <%= label_tag(:card_ids, "Card IDs (comma-separated)") %>
  <br>
  <%= text_field_tag(:card_ids, nil, placeholder: "e.g., 01001, 01002, 01003", size: 50) %>
  <br><br>
  <span>Only include factions (optional; leave all unchecked for all):</span><br>
  <% %w[guardian seeker rogue mystic survivor neutral mythos].each do |fc| %>
    <%= check_box_tag("faction_code[]", fc, false, id: "card_faction_#{fc}") %>
    <%= label_tag("card_faction_#{fc}", fc.titleize) %>
  <% end %>
  <br>
  <span>Only include types (optional; leave all unchecked for all):</span><br>
  <% %w[asset event skill treachery enemy location act agenda story investigator].each do |tc| %>
    <%= check_box_tag("type_code[]", tc, false, id: "card_type_#{tc}") %>
    <%= label_tag("card_type_#{tc}", tc.titleize) %>
  <% end %>
  <br><br>
  <%= submit_tag("Get PDF from Cards", data: { disable_with: false }) %>
<% end %>
</p>

<h3>Option 3: From Pack Code</h3>
<p>
<%= form_tag('/pack', method: "get", class: "pdf-form") do %>
  <%= label_tag(:pack_code, "Pack Code(s) - comma-separated for multiple") %>
  <br>
  <%= text_field_tag(:pack_code, nil, placeholder: "e.g., core, dwl, ptc", size: 50) %>
  <br><br>
  <span>Only include factions (optional; leave all unchecked for all):</span><br>
  <% %w[guardian seeker rogue mystic survivor neutral mythos].each do |fc| %>
    <%= check_box_tag("faction_code[]", fc, false, id: "pack_faction_#{fc}") %>
    <%= label_tag("pack_faction_#{fc}", fc.titleize) %>
  <% end %>
  <br>
  <span>Only include types (optional; leave all unchecked for all):</span><br>
  <% %w[asset event skill treachery enemy location act agenda story investigator].each do |tc| %>
    <%= check_box_tag("type_code[]", tc, false, id: "pack_type_#{tc}") %>
    <%= label_tag("pack_type_#{tc}", tc.titleize) %>
  <% end %>
  <br><br>
  <%= submit_tag("Get PDF from Pack(s)", data: { disable_with: false }) %>
<% end %>
</p>

<h2 style="margin-top: 40px;">Generic Card from Local Folder</h2>

<h3>Option 1: Single-Sided Cards (All cards use same back)</h3>
<p>
<form action="/folder/single" method="post" class="pdf-form">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= label_tag(:folder_paths, "Folder Paths (one per line, contains card front images)") %>
  <br>
  <%= text_area_tag(:folder_paths, nil, placeholder: "/Users/username/Desktop/cards1\n/Users/username/Desktop/cards2", rows: 4, cols: 60) %>
  <br><br>
  <%= label_tag(:back_image_path, "Card Back Image Path (full path to back image)") %>
  <br>
  <%= text_field_tag(:back_image_path, nil, placeholder: "/Users/username/Desktop/back.png", size: 60) %>
  <br><br>
  <%= submit_tag("Generate Single-Sided PDF", data: { disable_with: false }) %>
</form>
</p>

<h3>Option 2: Double-Sided Cards (Pairs of front/back)</h3>
<p>
<form action="/folder/double" method="post" class="pdf-form">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= label_tag(:folder_paths, "Folder Paths (one per line, images sorted alphabetically: 1st=front, 2nd=back, etc.)") %>
  <br>
  <%= text_area_tag(:folder_paths, nil, placeholder: "/Users/username/Desktop/cards1\n/Users/username/Desktop/cards2", rows: 4, cols: 60) %>
  <br><br>
  <%= submit_tag("Generate Double-Sided PDF", data: { disable_with: false }) %>
</form>
</p>

<h2 style="margin-top: 40px;">Netrunner Card Proxies</h2>

<h3>Option 1: From Card List</h3>
<p>
<form action="/netrunner" method="post" class="pdf-form">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= label_tag(:card_list, "Card List (one per line in format: 2x Card Title)") %>
  <br>
  <%= text_area_tag(:card_list, nil, placeholder: "2x Hedge Fund\n3x Sure Gamble\n1x Archer", rows: 10, cols: 50) %>
  <br>
  <%= submit_tag("Get Netrunner PDF", data: { disable_with: false }) %>
</form>
</p>

<h3>Option 2: From Pack Code</h3>
<p>
<form action="/netrunner/pack" method="post" class="pdf-form">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= label_tag(:pack_code, "Pack Code") %>
  <br>
  <%= text_field_tag(:pack_code, nil, placeholder: "e.g., core, td, ce", size: 50) %>
  <br>
  <%= submit_tag("Get Netrunner Pack PDF", data: { disable_with: false }) %>
</form>
</p>

<script>
  // Re-enable submit buttons after download starts
  document.querySelectorAll('.pdf-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      const submitBtn = this.querySelector('input[type="submit"]');
      // Re-enable button after 2 seconds
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.value = submitBtn.defaultValue;
      }, 2000);
    });
  });
</script>

<% if flash[:alert] %>
    <div class="alert" style="color: red; margin-top: 20px;"> <%= flash[:alert] %> </div>
<% end %>
